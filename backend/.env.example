# Server Settings
APP_NAME="Adaptive Zero Trust"
APP_ENV=development
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Database Settings
DATABASE_URL=sqlite:///../data/adaptive_zero_trust.db

# Security & CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Capture Settings
DEFAULT_CAPTURE_MODE=SIMULATED_TEST
TSHARK_PATH="C:\Program Files\Wireshark\tshark.exe"
PACKET_BUFFER_LIMIT=10000

# Zero Trust & Policies
TRUST_INITIAL_SCORE=100
TRUST_PENALTY_INFO=2
TRUST_PENALTY_PHISHING=15
TRUST_PENALTY_DNS_SPOOF=25
TRUST_PENALTY_ARP_SPOOF=30
BEHAVIOR_RISK_ISOLATE_THRESHOLD=70

# Response & Self-Healing
RESPONSE_MODE=SIMULATED
AUTO_RECOVERY_ENABLED=True
RECOVERY_COOLDOWN_MINUTES=5
RECOVERY_MIN_TRUST=80
RECOVERY_MAX_RISK=69
